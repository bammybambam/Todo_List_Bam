<div data-controller="sidebar" 
     id="main-sidebar"
     class="fixed top-0 right-0 h-screen z-50 bg-gray-100 p-4 transition-all duration-300 ease-in-out
            w-[75vw] md:w-[16vw] shadow-2xl md:shadow-none
            translate-x-full">

  <button data-action="click->sidebar#toggle" 
          class="absolute top-2 left-[-45px] bg-gray-100 p-2 rounded-l-lg shadow-md border-r border-gray-200">
    <span class="text-zinc-950 font-bold">☰</span>
  </button>

  <h2 class="text-center text-xl font-bold mb-6 text-zinc-950 transition-all duration-300">
    Sidebar
  </h2>

  <ul class="flex flex-col gap-4 items-center">
    <li class="w-full">
        <%= link_to "List", list_index_path, class: "bt-sidebar flex justify-center py-2 w-full" %>
    </li>
    <li class="w-full">
        <%= link_to profile_list_index_path, class: "bt-sidebar flex justify-center py-2 w-full" do %>
          Profile
        <% end %>
    </li>
    <li class="w-full">
        <%= link_to calendar_feed_url(format: :ics), class: "bt-sidebar flex justify-center py-2 w-full" do %>
          Export Calendar
        <% end %>
    </li>
        <li class="w-full">
        <%= link_to '/showcalendar', class: "bt-sidebar flex justify-center py-2 w-full" do %>
          Calendar
        <% end %>
    </li>

    <hr class="w-full border-gray-300 my-2">

    <% if user_signed_in? %>
      <li class="w-full">
        <%= button_to "Logout", logout_path, 
            method: :delete, 
            data: { turbo: false }, 
            form_class: "w-full", 
            class: "bt-sidebar w-full py-2 text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors" %>
      </li>
    <% else %>
      <li class="w-full">
        <%= button_to "Login", "/auth/keycloak", 
            data: { turbo: false }, 
            form_class: "w-full", 
            class: "bt-sidebar w-full py-2 bg-sky-600 text-white rounded-lg" %>
      </li>
    <% end %>
  </ul>
</div>