<div data-editcard-target="container" 
     class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
  
  <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" data-action="click->editcard#close"></div>

  <div class="relative bg-white w-full max-w-lg rounded-[24px] shadow-2xl overflow-hidden">
    
    <div class="p-6 border-b border-gray-100 bg-sky-50 flex justify-between items-center">
      <h3 class="text-xl font-bold text-sky-900">Edit Task</h3>
      <button data-action="click->editcard#close" class="text-gray-400 hover:text-gray-600 text-3xl leading-none">&times;</button>
    </div>

    <%= form_with model: todo, url: "/list/#{todo.id}", scope: :list , method: :patch do |f| %>
      <div class="p-8 space-y-4">
        <div>
          <%= f.label :title, "Title", class: "block font-bold mb-1 text-teal-900" %>
          <%= f.text_field :title, class: "w-full rounded-xl border-gray-500 text-zinc-500 focus:border-sky-500 focus:ring-sky-500" %>
        </div>

        <div>
          <%= f.label :desc, "Description", class: "block font-bold mb-1 text-teal-900" %>
          <%= f.text_area :desc, rows: 4, class: "w-full rounded-xl border-gray-200 text-zinc-500 focus:border-sky-500 focus:ring-sky-500" %>
        </div>
      </div>

      <div class="p-4 bg-gray-50 flex justify-end gap-2">
        <button type="button" data-action="click->editcard#close" class="px-6 py-2 bg-gray-400 text-white rounded-xl font-bold cursor-pointer">Cancel</button>
        <%= f.submit "Save Changes", class: "px-6 py-2 bg-sky-500 text-white rounded-xl font-bold hover:bg-sky-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>