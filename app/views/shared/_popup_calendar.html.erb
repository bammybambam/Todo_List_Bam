<div data-informationcard-target="container" 
     id="popup-date-<%= date.strftime("%Y-%m-%d") %>"
     class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 transition-all duration-300">
  
  <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-md" data-action="click->informationcard#close"></div>

  <div class="relative bg-slate-800 w-full h-auto max-w-md rounded-[24px] shadow-2xl overflow-hidden border border-slate-700">
    
    <div class="p-5 border-b border-slate-ok flex justify-between items-center bg-olive-50">
      <div>
        <h3 class="text-xl font-bold text-slate-500">Tasks for Today</h3>
        <p class="text-sky-400 text-sm font-medium"><%= date.strftime("%A, %d %B %Y") %></p>
      </div>
    </div>

    <div class="p-6 max-h-[60vh] overflow-y-auto bg-lime-200/95">
      <% if tasks.any? %>
        <div class="space-y-3">
          <% tasks.each do |task| %>
            <div class="p-4 rounded-xl bg- border border-slate-900 hover:border-sky-500/90 transition-all duration-300">
              <div class="flex justify-between items-start mb-1">
                <h4 class="font-bold text-slate-700"><%= task.title %></h4>
                <% if task.iscomplete %>
                  <span class="text-[10px] bg-cyan-500/10 text-slate-700 px-2 py-0.5 rounded-full">Done</span>
                <% end %>
              </div>
              <p class="text-sm text-slate-500 line-clamp-2"><%= task.desc %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-10">
          <p class="text-slate-500">No tasks for this day </p>
        </div>
      <% end %>
    </div>

    <div class="p-4 bg-olive-50 flex justify-center">
      <button data-action="click->informationcard#close" 
              class="w-full py-3 bg-gray-500/95 text-white rounded-xl font-bold hover:bg-gray-700/95 transition-all cursor-pointer">
        Close
      </button>
    </div>
  </div>
</div>