<div data-informationcard-target="container" 
     class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 transition-all duration-300">
  
  <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" data-action="click->informationcard#close"></div>

  <div class="relative bg-white w-full h-auto max-w-lg rounded-[24px] shadow-2xl overflow-hidden transform transition-all">
    
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-emerald-50">
      <h3 class="text-xl font-bold text-emerald-900 break-words"><%= todo.title %></h3>
      <button data-action="click->informationcard#close" class="text-gray-400 hover:text-gray-600 text-3xl leading-none cursor-pointer">&times;</button>
    </div>

    <div class="p-8 max-h-[50vh] overflow-y-auto text-gray-700">
      <div class="space-y-4">   
        <div class="flex items-center gap-2 text-sm text-emerald-600 font-semibold uppercase tracking-wider">
          <span>Detail</span>
          <div class="h-[1px] flex-1 bg-emerald-100"></div>
        </div>
        <p class="leading-relaxed whitespace-pre-wrap break-words"><%= todo.desc %></p>
       <div class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-2">
          <label class="font-semibold">Due Date : </label>
          <p><%= todo.due_date&.strftime("%d-%m-%Y") %></p>
          <label class="font-semibold">End Date :</label>
          <p><%= todo.end_date&.strftime("%d-%m-%Y") %></p>
          
        </div>

      </div>
    </div>

    <div class="p-4 bg-gray-50 flex justify-end gap-3">
      <button data-action="click->informationcard#close" 
              class="px-6 py-2 bg-emerald-500 text-white rounded-[12px] font-semibold hover:bg-emerald-600 transition-colors cursor-pointer">
        Close
      </button>
    </div>
  </div>
</div>